            android:name="com.abdev.partituraspdf.app.integration.CanonicalPdfContentProvider"
            android:authorities="com.abdev.partituraspdf.test.integration.pdf"
            android:exported="true" />
        <!-- Phase M disposable DocumentsProvider, test APK only; access requires explicit URI grants. -->
