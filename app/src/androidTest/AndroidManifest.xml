<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Test APK only; never packaged in the production application. -->
        <provider
            android:name="com.abdev.partituraspdf.storage.saf.SafFixtureContentProvider"
            android:authorities="com.abdev.partituraspdf.test.saf.fixture"
            android:exported="true" />
