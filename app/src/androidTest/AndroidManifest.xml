            android:name="com.abdev.partituraspdf.storage.transaction.testprovider.MNewDocumentProvider"
            android:authorities="com.abdev.partituraspdf.test.m.newdocument"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
