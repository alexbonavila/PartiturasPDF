<?xml version="1.0" encoding="utf-8"?>
<!-- Policy B, API 31+: explicitly restrict both cloud backup and device transfer.
     Only the entire non-sensitive settings protobuf is eligible; no Room/SQLite files. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/app_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/app_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
